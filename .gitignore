# fullrmc / pyrep benchmark scratch (regenerated by tools/, never committed)
*.rmc/
.pyrep*
trajectory.xyz
restart.pdb
tools/cpp_*.xml
tools/frmc_ncores.json
tools/gr_scaling.png

